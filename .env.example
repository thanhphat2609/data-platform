# data-platform — environment variables
# Copy to .env and fill in your values before running any component.
# For the full demo stack use infrastructure/dagster/demo/.env.demo instead.

# ── Azure Blob Storage (destination for dlt + Spark SDP) ──────────────────────
# Account name must match what is hardcoded in ingestion/sdp/pipelines/*/pipeline.yml
AZURE_STORAGE_ACCOUNT_NAME=dataplatformstrorage
AZURE_STORAGE_ACCOUNT_KEY=<your_storage_account_key>

# ── PostgreSQL CRM DB (dlt source) ────────────────────────────────────────────
POSTGRES_CONNECTION_STRING=postgresql://admin:admin123@postgres-crm:5432/crm

# ── PostgreSQL manage DB (Spark SDP source) ───────────────────────────────────
POSTGRES_HOST=postgres-manage
POSTGRES_PORT=5432
POSTGRES_MANAGE_DB=manage
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# ── MySQL ecommerce DB (Spark SDP source) ─────────────────────────────────────
MYSQL_HOST=mysql-ecommerce
MYSQL_PORT=3306
MYSQL_DB=ecommerce
MYSQL_USER=admin
MYSQL_PASSWORD=admin123

# ── Dagster ────────────────────────────────────────────────────────────────────
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@dagster-db:5432/dagster

# Azure Blob Storage for Dagster compute logs (production dagster.yaml)
AZURE_STORAGE_ACCOUNT=dataplatformstrorage
AZURE_STORAGE_KEY=<your_storage_account_key>

# ── Pipeline images ────────────────────────────────────────────────────────────
DLT_IMAGE=dlt-pipeline:latest
SDP_IMAGE=spark-pipeline:latest
DBT_IMAGE=dbt-pipeline:latest

# ── dbt / DuckDB transformation ────────────────────────────────────────────────
# Gold output path for the example ecommerce orders mart (external materialization)
GOLD_ECOMMERCE_ORDERS_PATH=az://gold/ecommerce/fct_orders

# ── API Sources (dlt events pipeline) ─────────────────────────────────────────
USGS_MIN_MAGNITUDE=1.0
OPENMETEO_LAT=10.8231
OPENMETEO_LON=106.6297
EXCHANGERATES_API_KEY=
