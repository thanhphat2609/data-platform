{
  "_comment": "Airbyte connection template — Exchange Rates API → MinIO (bronze/airbyte/exchangerates/)",
  "_note": "Configure via Airbyte UI at http://<server-ip>:8000 or Airbyte API at :8001",

  "name": "exchangerates-daily",
  "geography": "auto",

  "source": {
    "name": "Exchange Rates API",
    "sourceDefinitionId": "25c9c8a5-a6db-4aed-86b6-2b0e89698a39",
    "connectionConfiguration": {
      "base": "USD",
      "api_key": "<EXCHANGERATES_API_KEY>",
      "start_date": "2024-01-01",
      "symbols": ["EUR", "GBP", "JPY", "SGD", "VND", "KRW", "AUD"]
    }
  },

  "destination": {
    "$ref": "../destination/minio_s3.json",
    "connectionConfiguration": {
      "s3_path_format": "bronze/airbyte/exchangerates/{namespace}/{stream_name}/{year}/{month}/{day}"
    }
  },

  "schedule": {
    "scheduleType": "cron",
    "cronExpression": "0 2 * * *"
  },

  "syncCatalog": {
    "streams": [
      { "stream": { "name": "rates" }, "config": { "syncMode": "incremental_append_dedup", "destinationSyncMode": "append_dedup" } }
    ]
  }
}
