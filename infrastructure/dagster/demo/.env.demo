# Demo environment templates — copy the relevant file before starting each stack.
#
# NON-PROD (single VM):
#   cp infrastructure/dagster/demo/.env.demo    infrastructure/dagster/demo/.env
#
# PROD control plane:
#   cp infrastructure/dagster/demo/.env.demo    infrastructure/dagster/demo/.env
#   (uses same Azure + image vars; source DB containers not needed)
#
# PROD worker-1 VM:
#   cp infrastructure/dagster/demo/.env.worker1.demo  infrastructure/dagster/demo/.env.worker1
#
# PROD worker-2 VM:
#   cp infrastructure/dagster/demo/.env.worker2.demo  infrastructure/dagster/demo/.env.worker2

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Must match the account name hardcoded in:
#   ingestion/sdp/pipelines/ecommerce/pipeline.yml
#   ingestion/sdp/pipelines/manage/pipeline.yml
# (spark.hadoop.fs.azure.account.key.<account_name>.dfs.core.windows.net)
AZURE_STORAGE_ACCOUNT_NAME=dataplatformstrorage
AZURE_STORAGE_ACCOUNT_KEY=<your_storage_account_key>

# ── Pipeline image tags ───────────────────────────────────────────────────────
# Build before running docker compose up:
#   docker build -t dlt-pipeline:latest   -f infrastructure/dlt/Dockerfile .
#   docker build -t spark-pipeline:latest -f infrastructure/spark/Dockerfile.spark .
DLT_IMAGE=dlt-pipeline:latest
SDP_IMAGE=spark-pipeline:latest
