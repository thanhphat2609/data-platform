{
  "_comment": "Airbyte connection template — Open-Meteo Weather API → MinIO (bronze/airbyte/openmeteo/)",
  "_note": "Configure via Airbyte UI at http://<server-ip>:8000 or Airbyte API at :8001",

  "name": "openmeteo-hourly",
  "geography": "auto",

  "source": {
    "name": "Open-Meteo",
    "sourceDefinitionId": "f3cde6dc-7ef6-4b97-b7e0-70e81ca4b5c5",
    "connectionConfiguration": {
      "latitude": 10.8231,
      "longitude": 106.6297,
      "hourly": [
        "temperature_2m",
        "precipitation",
        "windspeed_10m",
        "weathercode"
      ],
      "timezone": "Asia/Ho_Chi_Minh",
      "start_date": "2024-01-01",
      "end_date": "9999-12-31"
    }
  },

  "destination": {
    "$ref": "../destination/minio_s3.json",
    "connectionConfiguration": {
      "s3_path_format": "bronze/airbyte/openmeteo/{namespace}/{stream_name}/{year}/{month}/{day}"
    }
  },

  "schedule": {
    "scheduleType": "cron",
    "cronExpression": "0 1 * * *"
  },

  "syncCatalog": {
    "streams": [
      { "stream": { "name": "hourly" }, "config": { "syncMode": "incremental_append_dedup", "destinationSyncMode": "append_dedup" } }
    ]
  }
}
