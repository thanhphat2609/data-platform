[Unit]
Description=Dagster (Webserver + Daemon)
After=network.target postgresql.service redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/home/azureuser/dagster-demo
ExecStart=/home/azureuser/dagster-demo/venv/bin/dagster dev -h 0.0.0.0 -p 3000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
