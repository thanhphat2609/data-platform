# Worker VM 2 environment — copy to .env.worker2 before starting:
#   cp infrastructure/dagster/worker/.env.worker2.demo infrastructure/dagster/worker/.env.worker2
#
# Usage:
#   docker compose -f infrastructure/dagster/worker/docker-compose-worker2.yml \
#                  --env-file infrastructure/dagster/worker/.env.worker2 up -d

# ── Control plane connection ───────────────────────────────────────────────────
# Replace <ctrl-vm-ip> with the control VM's private IP or hostname.
# DAGSTER_DB_PASSWORD must match what is set in infrastructure/dagster/control/.env
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@<ctrl-vm-ip>:5432/dagster_db
CELERY_BROKER_URL=redis://<ctrl-vm-ip>:6379/0
CELERY_RESULT_BACKEND=redis://<ctrl-vm-ip>:6379/0

# ── SDP pipeline image ─────────────────────────────────────────────────────────
# Build on this VM before starting (takes ~5 min, needs 6+ GB RAM for Spark):
#   docker build -t spark-pipeline:latest -f infrastructure/spark/Dockerfile.spark .
SDP_IMAGE=spark-pipeline:latest

# ── Azure Blob Storage ─────────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=dataplatformstrorage
AZURE_STORAGE_ACCOUNT_KEY=<your_storage_account_key>

# ── Ecommerce source — managed MySQL ──────────────────────────────────────────
MYSQL_HOST=<mysql-db-host>
MYSQL_PORT=3306
MYSQL_DB=ecommerce
MYSQL_USER=admin
MYSQL_PASSWORD=<mysql_password>

# ── Manage source — managed PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=<manage-db-host>
POSTGRES_PORT=5432
POSTGRES_MANAGE_DB=manage
POSTGRES_USER=admin
POSTGRES_PASSWORD=<pg_password>
