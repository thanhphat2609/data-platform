{
  "_comment": "Airbyte connection template — GitHub Events → MinIO (bronze/airbyte/github/)",
  "_note": "Configure via Airbyte UI at http://<server-ip>:8000 or Airbyte API at :8001",

  "name": "github-events",
  "geography": "auto",

  "source": {
    "name": "GitHub",
    "sourceDefinitionId": "ef69ef6e-aa7f-4af1-a01d-ef775033524e",
    "connectionConfiguration": {
      "credentials": {
        "option_title": "PAT Credentials",
        "personal_access_token": "<GITHUB_TOKEN>"
      },
      "repositories": ["<owner>/<repo>"],
      "start_date": "2024-01-01T00:00:00Z",
      "streams": [
        { "name": "events",        "syncMode": "incremental" },
        { "name": "commits",       "syncMode": "incremental" },
        { "name": "pull_requests", "syncMode": "incremental" },
        { "name": "issues",        "syncMode": "incremental" }
      ]
    }
  },

  "destination": {
    "$ref": "../destination/minio_s3.json",
    "connectionConfiguration": {
      "s3_path_format": "bronze/airbyte/github/{namespace}/{stream_name}/{year}/{month}/{day}"
    }
  },

  "schedule": {
    "scheduleType": "cron",
    "cronExpression": "0 */6 * * *"
  },

  "syncCatalog": {
    "streams": [
      { "stream": { "name": "events" },        "config": { "syncMode": "incremental_append_dedup", "destinationSyncMode": "append_dedup" } },
      { "stream": { "name": "commits" },       "config": { "syncMode": "incremental_append_dedup", "destinationSyncMode": "append_dedup" } },
      { "stream": { "name": "pull_requests" }, "config": { "syncMode": "incremental_append_dedup", "destinationSyncMode": "append_dedup" } },
      { "stream": { "name": "issues" },        "config": { "syncMode": "incremental_append_dedup", "destinationSyncMode": "append_dedup" } }
    ]
  }
}
