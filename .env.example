# data-platform-ingestion — environment variables
# Copy to .env and edit before running ingestion commands
#
# Infrastructure (PostgreSQL, MySQL, MinIO) is managed by data-platform-infra.
# These values must match the .env in that repo.

# ── PostgreSQL (platform DB — dlt CDC) ────────────────────────
POSTGRES_HOST=infra-postgres
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# PostgreSQL manage DB (Spark SDP)
POSTGRES_MANAGE_DB=manage

# ── MySQL (sales DB — Spark SDP) ──────────────────────────────
MYSQL_HOST=infra-mysql
MYSQL_PORT=3306
MYSQL_DB=sales
MYSQL_USER=admin
MYSQL_PASSWORD=admin123

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ENDPOINT=http://infra-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ── Dagster ───────────────────────────────────────────────────
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@postgres:5432/dagster_db

# Azure Blob Storage (Dagster compute logs + asset IO manager)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key

# ── API Sources (dlt) ─────────────────────────────────────────
# GitHub — create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=thanhphat2609/data-platform-ingestion

# Open-Meteo — free, no key required
OPENMETEO_LAT=10.8231
OPENMETEO_LON=106.6297

# Exchange Rates — free tier at https://frankfurter.app (no key needed)
# Or paid key from https://exchangeratesapi.io
EXCHANGERATES_API_KEY=
