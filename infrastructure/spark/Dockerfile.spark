FROM apache/spark:4.1.2-python3

USER root

RUN pip install --upgrade --no-cache-dir "pyspark[pipelines]>=4.1.2" && \
    rm -rf /opt/spark/python/pyspark

# Combine all JAR downloads into a single layer to optimize image size
RUN curl -fL -o /opt/spark/jars/delta-spark_2.13-4.0.0.jar \
        https://repo1.maven.org/maven2/io/delta/delta-spark_2.13/4.0.0/delta-spark_2.13-4.0.0.jar && \
    curl -fL -o /opt/spark/jars/delta-storage-4.0.0.jar \
        https://repo1.maven.org/maven2/io/delta/delta-storage/4.0.0/delta-storage-4.0.0.jar && \
    # Azure Blob Storage (replaces hadoop-aws / aws-sdk-bundle used in MinIO setup)
    curl -fL -o /opt/spark/jars/hadoop-azure-3.4.1.jar \
        https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-azure/3.4.1/hadoop-azure-3.4.1.jar && \
    curl -fL -o /opt/spark/jars/azure-storage-8.6.6.jar \
        https://repo1.maven.org/maven2/com/microsoft/azure/azure-storage/8.6.6/azure-storage-8.6.6.jar && \
    # hadoop-azure's WASB driver needs JSON$Convertor from jetty-util-ajax.
    # Spark 4.1 ships Jetty 12 which split this into a separate artifact not included by default.
    curl -fL -o /opt/spark/jars/jetty-util-ajax-9.4.53.v20231009.jar \
        https://repo1.maven.org/maven2/org/eclipse/jetty/jetty-util-ajax/9.4.53.v20231009/jetty-util-ajax-9.4.53.v20231009.jar && \
    # PostgreSQL JDBC Driver
    curl -fL -o /opt/spark/jars/postgresql-42.7.3.jar \
        https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar && \
    # MySQL JDBC Driver
    curl -fL -o /opt/spark/jars/mysql-connector-j-8.4.0.jar \
        https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.4.0/mysql-connector-j-8.4.0.jar

ENV PYTHONPATH=/usr/local/lib/python3.10/dist-packages:/opt/spark/python:/opt/spark/python/lib/py4j-0.10.9.7-src.zip:$PYTHONPATH

# Bake all pipeline specs into the image — runtime only, no dispatcher.
# Pass the spec path as the command:
#   docker run spark-pipeline:latest spark-pipelines run --spec /opt/spark/pipeline/ecommerce/pipeline.yml
#   docker run spark-pipeline:latest spark-pipelines run --spec /opt/spark/pipeline/manage/pipeline.yml
COPY ingestion/sdp/pipelines /opt/spark/pipeline

USER spark
