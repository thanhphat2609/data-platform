# Control VM environment — copy to .env before starting:
#   cp infrastructure/dagster/control/.env.demo infrastructure/dagster/control/.env
#
# Usage:
#   docker compose -f infrastructure/dagster/control/docker-compose.yml \
#                  --env-file infrastructure/dagster/control/.env up -d

# ── Dagster metadata DB password ───────────────────────────────────────────────
# Worker VMs must use this same password in their DAGSTER_POSTGRES_URL.
DAGSTER_DB_PASSWORD=dagster

# ── Azure Blob Storage ─────────────────────────────────────────────────────────
# Used by dagster.yaml to write compute logs to azure://dagster-logs/compute-logs
AZURE_STORAGE_ACCOUNT_NAME=dataplatformstrorage
AZURE_STORAGE_ACCOUNT_KEY=<your_storage_account_key>
