# Worker VM 1 environment — copy to .env.worker1 before starting:
#   cp infrastructure/dagster/worker/.env.worker1.demo infrastructure/dagster/worker/.env.worker1
#
# Usage:
#   docker compose -f infrastructure/dagster/worker/docker-compose-worker1.yml \
#                  --env-file infrastructure/dagster/worker/.env.worker1 up -d

# ── Control plane connection ───────────────────────────────────────────────────
# Replace <ctrl-vm-ip> with the control VM's private IP or hostname.
# DAGSTER_DB_PASSWORD must match what is set in infrastructure/dagster/control/.env
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@<ctrl-vm-ip>:5432/dagster_db
CELERY_BROKER_URL=redis://<ctrl-vm-ip>:6379/0
CELERY_RESULT_BACKEND=redis://<ctrl-vm-ip>:6379/0

# ── dlt pipeline image ─────────────────────────────────────────────────────────
# Build on this VM before starting:
#   docker build -t dlt-pipeline:latest -f infrastructure/dlt/Dockerfile .
DLT_IMAGE=dlt-pipeline:latest

# ── Azure Blob Storage ─────────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=dataplatformstrorage
AZURE_STORAGE_ACCOUNT_KEY=<your_storage_account_key>

# ── CRM source — managed PostgreSQL ───────────────────────────────────────────
POSTGRES_CONNECTION_STRING=postgresql://admin:<password>@<crm-db-host>:5432/crm
